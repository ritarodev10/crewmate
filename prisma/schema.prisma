// CrewMate Prisma schema.
// Source of truth for the data model. See nestjs-ai-guardrails/04-DATA.md
// for the patterns this schema is designed to support.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Operator {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users        User[]
  properties   Property[]
  workers      Worker[]
  jobs         Job[]
  schedules    Schedule[]
  roleGrants   RoleGrant[]
  webhooks     WebhookEndpoint[]
  outbox       OutboxEvent[]
  permissionAudits PermissionAudit[]

  @@map("operators")
}

// ---------------------------------------------------------------------------
// Users and authorization
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  operatorId   String   @map("operator_id") @db.Uuid
  email        String
  passwordHash String   @map("password_hash")
  name         String
  isSuperAdmin Boolean  @default(false) @map("is_super_admin")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  operator     Operator     @relation(fields: [operatorId], references: [id])
  roleGrants   RoleGrant[]
  jobsAsWorker Job[]        @relation("JobWorker")

  @@unique([operatorId, email])
  @@index([operatorId])
  @@map("users")
}

model RoleGrant {
  id         String   @id @default(uuid()) @db.Uuid
  operatorId String   @map("operator_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  role       String                          // system role name or custom role id (v0.2)
  scope      Json                            // ScopeRef from @crewmate/contracts
  grantedBy  String   @map("granted_by") @db.Uuid
  grantedAt  DateTime @default(now()) @map("granted_at")
  expiresAt  DateTime? @map("expires_at")

  operator   Operator @relation(fields: [operatorId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@index([operatorId, userId])
  @@index([operatorId, role])
  @@map("role_grants")
}

model PermissionAudit {
  id           String   @id @default(uuid()) @db.Uuid
  operatorId   String   @map("operator_id") @db.Uuid
  requestId    String   @map("request_id") @db.Uuid
  actorUserId  String   @map("actor_user_id") @db.Uuid
  action       String
  subject      String
  subjectId    String?  @map("subject_id") @db.Uuid
  decision     String                         // 'allow' | 'deny'
  reason       String
  createdAt    DateTime @default(now()) @map("created_at")

  operator     Operator @relation(fields: [operatorId], references: [id])

  @@index([operatorId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("permission_audits")
}

// ---------------------------------------------------------------------------
// Operations domain
// ---------------------------------------------------------------------------

model Property {
  id         String   @id @default(uuid()) @db.Uuid
  operatorId String   @map("operator_id") @db.Uuid
  name       String
  kind       String                            // PropertyKind enum
  regionId   String?  @map("region_id") @db.Uuid
  address    String
  timezone   String   @default("UTC")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  operator   Operator @relation(fields: [operatorId], references: [id])
  jobs       Job[]

  @@index([operatorId])
  @@index([operatorId, regionId])
  @@map("properties")
}

model Worker {
  id         String   @id @default(uuid()) @db.Uuid
  operatorId String   @map("operator_id") @db.Uuid
  userId     String?  @unique @map("user_id") @db.Uuid // null = unclaimed worker record
  name       String
  phone      String?
  hourlyRate Decimal? @map("hourly_rate") @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  operator   Operator @relation(fields: [operatorId], references: [id])
  schedules  Schedule[]

  @@index([operatorId])
  @@map("workers")
}

model Job {
  id            String   @id @default(uuid()) @db.Uuid
  operatorId    String   @map("operator_id") @db.Uuid
  propertyId    String   @map("property_id") @db.Uuid
  workerId      String?  @map("worker_id") @db.Uuid
  type          String                              // JobType enum
  status        String   @default("SCHEDULED")      // JobStatus enum
  scheduledFor  DateTime @map("scheduled_for")
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  notes         String?
  photos        Json     @default("[]")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  operator      Operator @relation(fields: [operatorId], references: [id])
  property      Property @relation(fields: [propertyId], references: [id])
  worker        User?    @relation("JobWorker", fields: [workerId], references: [id])
  statusHistory JobStatusEvent[]

  @@index([operatorId, status, scheduledFor])
  @@index([operatorId, workerId, scheduledFor])
  @@index([operatorId, propertyId])
  @@map("jobs")
}

model JobStatusEvent {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  actorUserId String  @map("actor_user_id") @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at")

  job        Job     @relation(fields: [jobId], references: [id])

  @@index([jobId, occurredAt])
  @@map("job_status_events")
}

model Schedule {
  id         String   @id @default(uuid()) @db.Uuid
  operatorId String   @map("operator_id") @db.Uuid
  workerId   String   @map("worker_id") @db.Uuid
  day        DateTime @db.Date
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  operator   Operator @relation(fields: [operatorId], references: [id])
  worker     Worker   @relation(fields: [workerId], references: [id])

  @@unique([workerId, day])
  @@index([operatorId, day])
  @@map("schedules")
}

// ---------------------------------------------------------------------------
// Webhooks (event spine)
// ---------------------------------------------------------------------------

model WebhookEndpoint {
  id         String   @id @default(uuid()) @db.Uuid
  operatorId String   @map("operator_id") @db.Uuid
  url        String
  events     String[]                          // e.g. ["job.created", "job.status.changed"]
  secret     String
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  operator   Operator @relation(fields: [operatorId], references: [id])
  deliveries WebhookDelivery[]

  @@index([operatorId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id          String   @id @default(uuid()) @db.Uuid
  endpointId  String   @map("endpoint_id") @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  eventName   String   @map("event_name")
  payload     Json
  attempt     Int      @default(1)
  status      String                            // 'pending' | 'success' | 'failed'
  responseCode Int?    @map("response_code")
  responseBody String? @map("response_body")
  deliveredAt DateTime? @map("delivered_at")
  createdAt   DateTime @default(now()) @map("created_at")

  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id])

  @@index([endpointId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("webhook_deliveries")
}

model OutboxEvent {
  id         String   @id @default(uuid()) @db.Uuid
  operatorId String   @map("operator_id") @db.Uuid
  eventName  String   @map("event_name")
  payload    Json
  processed  Boolean  @default(false)
  attempts   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  operator   Operator @relation(fields: [operatorId], references: [id])

  @@index([processed, createdAt])
  @@map("outbox_events")
}
