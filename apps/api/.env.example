# Copy to .env and fill in values for local dev

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crewmate
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-refresh

# Shared secret between Cloudflare Worker and API — must match CF Worker [vars]
CLOUDFLARE_SECRET=local-dev-secret

NODE_ENV=development
PORT=6201
