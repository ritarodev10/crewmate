# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database
DATABASE_URL=postgres://crewmate:crewmate@localhost:5432/crewmate

# Redis (cache + BullMQ)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=replace-me-with-a-32-byte-secret-min
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Webhook signing
WEBHOOK_SIGNING_KEY=replace-me-with-a-strong-shared-secret

# CORS
CORS_ORIGIN=http://localhost:3001

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=60
